{
  
    "cli": {
      "version": ">= 18.5.0",
      "appVersionSource": "remote"
    },
    "build": {
      "development": {
        "node": "24.14.0",
        "developmentClient": true,
        "distribution": "internal",
        "env": {
          "EXPO_ANDROID_ALLOW_CLEARTEXT": "1",
          "EXPO_PUBLIC_INCLUDE_PROVIDER_SUITE": "1"
        }
      },
      "preview": {
        "node": "24.14.0",
        "distribution": "internal",
        "env": {
          "EXPO_PUBLIC_INCLUDE_PROVIDER_SUITE": "0"
        }
      },
      "production": {
        "node": "24.14.0",
        "autoIncrement": true,
        "environment": "production",
        "developmentClient": false,
        "distribution": "store",
        "android": {
          "buildType": "app-bundle"
        },
        "env": {
          "EXPO_PUBLIC_INCLUDE_PROVIDER_SUITE": "0",
          "EXPO_PUBLIC_COMMUNITY_ENABLED": "false",
          "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://recoveryroad.app/privacy",
          "EXPO_PUBLIC_TERMS_OF_SERVICE_URL": "https://recoveryroad.app/terms",
          "EXPO_PUBLIC_SUPPORT_URL": "https://recoveryroad.app/contact",
          "EXPO_PUBLIC_SUPPORT_EMAIL": "support@recoveryroad.app"
        },
        "ios": {
          "resourceClass": "medium"
        }
      }
    },
    "submit": {
      "production": {
        "android": {
          "applicationId": "com.webiq.recoveryroad",
          "track": "internal",
          "releaseStatus": "completed"
        },
        "ios": {
          "ascAppId": "6764677522",
          "appleTeamId": "KYVDD7RCP8"
        }
      }
    }
  }
