# Files excluded from the EAS Build upload archive.
#
# IMPORTANT: when this file exists, EAS uses it INSTEAD of .gitignore, so every
# .gitignore rule has to be repeated here. Keep the first section in sync with
# .gitignore; put upload-only exclusions in the second section.

# ---------------------------------------------------------------- .gitignore

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
.expo-build-test/
expo-env.d.ts

# Native (regenerated by prebuild on EAS)
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Live social API persisted state (self-hosted / staging)
backend/social/data/

# ----------------------------------------------------- upload-only additions

# Pre-SDK-57 Gradle output kept as a local backup: ~1.4 GB of .gradle/ and
# build/. Git skips it via a nested .gitignore, but the EAS archiver only reads
# the root ignore file, so it has to be listed explicitly.
RecoveryRoad-android-before-sdk57/

# Scratch prebuild output from local iOS/build experiments
.expo-ios-test/
.expo-ios-test2/

# Editor state and local logs
.idea/
*.log
android-build-error.txt
